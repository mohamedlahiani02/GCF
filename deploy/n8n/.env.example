# Copy to .env (never committed) and fill in.

# Exact n8n image tag, checked on the n8n release page. The same tag runs locally and on the server.
N8N_VERSION=
# Encrypts the credentials stored in n8n. Generate once with: openssl rand -hex 32
# Keep it: the same key is needed to move the n8n data to another server.
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
TIMEZONE=Africa/Tunis

# Where n8n calls the GCF API. From the container, a GCF running on the host is http://host.docker.internal:3000
GCF_API_URL=http://host.docker.internal:3000
# The signing secret shown once by GCF when the webhook is created (Paramètres > Intégrations > Webhooks).
GCF_WEBHOOK_SECRET=
